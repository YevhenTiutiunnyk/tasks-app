# Ключ Anthropic приложению больше не нужен: у каждого пользователя свой,
# он вводится в настройках и лежит в базе зашифрованным. Эта переменная
# остаётся только для платных тестов разбора фраз (RUN_LLM_TESTS=1).
ANTHROPIC_API_KEY=sk-ant-...
# 32 случайных байта в base64: openssl rand -base64 32
# Потеря означает, что все пользователи вводят свои ключи заново.
KEY_ENCRYPTION_KEY=случайные-32-байта-в-base64
DATABASE_URL=postgresql://postgres.xxx:пароль@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=случайная-строка-минимум-32-символа
GOOGLE_CLIENT_ID=из Google Cloud Console
GOOGLE_CLIENT_SECRET=из Google Cloud Console
